{
  "name": "alasel-motors",
  "private": true,
  "version": "1.0.0",
  "description": "الأصيل موتورز — نظام إدارة محركات السيارات والمواتير",
  "author": {
    "name": "Al-Aseel Motors",
    "email": "info@alasel-motors.com"
  },
  "desktopName": "alasel-motors",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently -k \"cross-env NODE_ENV=development vite\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "build": "tsc -b && vite build",
    "build:electron": "tsc --project tsconfig.electron.json",
    "build:all": "npm run build && npm run build:electron",
    "dist:linux": "npm run build:all && electron-builder --linux",
    "dist:win": "npm run build:all && electron-builder --win",
    "dist:all": "npm run build:all && electron-builder --linux --win",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "clsx": "^2.1.1",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.4.0",
    "lucide-react": "^1.46.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.0",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^36.4.0",
    "electron-builder": "^26.0.12",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.alasel.motors",
    "productName": "الأصيل موتورز",
    "copyright": "Copyright © 2025 Al-Aseel Motors",
    "icon": "public/logo.png",
    "directories": {
      "output": "release",
      "buildResources": "public"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "public/logo.png",
      "package.json"
    ],
    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] }
      ],
      "category": "Office",
      "synopsis": "Al-Aseel Motors Management System",
      "description": "Al-Aseel Motors — Car engines inventory and sales management",
      "maintainer": "Al-Aseel Motors <info@alasel-motors.com>"
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "public/logo.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": ["ar-SA"],
      "language": "1025",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "الأصيل موتورز"
    }
  }
}
